# Verbalystic environment configuration
# Copy this file to .env for local backend development.
# Never commit real .env files or real secret values.

# REQUIRED: PostgreSQL/Supabase database connection string used by backend/database.py.
# Example format: postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=your_database_url_here

# REQUIRED for AI feedback: Gemini API key used only by backend/ai_service.py.
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Gemini model name. Defaults to gemini-3.7-flash in code.
GEMINI_MODEL=gemini-3.7-flash

# REQUIRED for backend Supabase Auth token validation.
# Use your Supabase project URL and public anon key, not the service-role key.
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OPTIONAL: Comma-separated HTTP origins allowed by FastAPI CORS.
CORS_ALLOWED_ORIGINS=https://verbalystic-nu.vercel.app

# OPTIONAL: Comma-separated Socket.IO origins allowed for realtime audio.
SOCKET_IO_ALLOWED_ORIGINS=https://verbalystic-nu.vercel.app

# OPTIONAL: Maximum uploaded audio file size in bytes.
# Defaults to 25000000 in code when unset.
MAX_AUDIO_UPLOAD_BYTES=25000000
